# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TAVILY_API_KEY: Required for real-time web search in the Wardroby stylist chatbot.
# Configure this in the Secrets panel in the AI Studio UI.
TAVILY_API_KEY="MY_TAVILY_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Firebase Web SDK overrides (used by server.ts /api/firebase-config).
# Set FIREBASE_API_KEY in Secrets if you rotate the Firebase Web API key.
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_FIRESTORE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""

# Optional direct server email delivery for the Contact Us form
CONTACT_RECIPIENT_EMAIL="rahul.kej05@gmail.com"
RESEND_API_KEY=""


